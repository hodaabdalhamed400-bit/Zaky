# ───── ZAKI Smart ERP — متغيرات البيئة ─────
# انسخ هذا الملف إلى .env ولا ترفع .env إلى Git أبدًا.

# قاعدة البيانات (PostgreSQL 14+). في Render استخدم Internal Database URL.
DATABASE_URL="postgresql://zaki:CHANGE_ME@localhost:5432/zaki_dev?schema=public"

# قاعدة الاختبارات (يجب أن يحتوي اسمها على test) — تُمسح بالكامل عند كل تشغيل للاختبارات
TEST_DATABASE_URL="postgresql://zaki:CHANGE_ME@localhost:5432/zaki_test?schema=public"

# الجلسات
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120

# الكوكي الآمنة (افتراضيًا true في الإنتاج). لا تضعها false في الإنتاج.
# COOKIE_SECURE=true

# مجلد التخزين الخاص للمستندات (خارج public). في Render: /var/data/storage على قرص دائم
STORAGE_DIR=./storage

# سر نقطة المهمة اليومية POST /api/cron/daily (24 حرفًا على الأقل). اتركه فارغًا لتعطيلها
# CRON_SECRET=

# مفتاح تشفير أسرار التحقق الثنائي (32 حرفًا على الأقل) — إلزامي في الإنتاج
# مثال للتوليد: openssl rand -base64 36
MFA_ENCRYPTION_KEY=

# فرض التحقق الثنائي على أدوار الإدارة (الافتراضي: مفعل في الإنتاج، معطل في التطوير)
# MFA_ENFORCE=true

# عدد الوكلاء العكسيين الموثوقين لقراءة IP العميل من X-Forwarded-For (Render = 1)
TRUSTED_PROXY_HOPS=1

# يُستخدم فقط مع: npm run admin:create (لا يُخزَّن في الكود)
# ZAKI_ADMIN_PASSWORD=
